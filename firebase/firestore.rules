rules_version = '2';

// Laravel/MySQL is the authoritative store for all EataLyft business data.
// Clients must never directly create or mutate bookings, seats, tickets,
// agencies, schedules, wallets, payment state or user-role records in Firestore.
// Realtime read models may be introduced later with narrowly scoped rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
