rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users may manage only their own profile image uploads.
    match /users/{uid}/avatars/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Agency documents and all other files are uploaded through Laravel,
    // which enforces agency/branch permissions and private access policies.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
