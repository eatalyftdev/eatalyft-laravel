APP_NAME=EataLyft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eatalyft_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase environment (use separate projects and credentials per environment)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_ID=(default)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Administrator account (local development only — never commit production credentials)
ADMIN_NAME="EataLyft Administrator"
ADMIN_EMAIL="admin@eatalyft.local"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_STRONG_UNIQUE_PASSWORD"

# Error Monitoring Configuration
ERROR_MONITORING_ENABLED=true
ERROR_ALERTS_ENABLED=false
ERROR_ALERT_EMAIL=
ERROR_TELEGRAM_ENABLED=false
ERROR_TELEGRAM_BOT_TOKEN=
ERROR_TELEGRAM_CHAT_ID=
ERROR_SUPPRESSION_INTERVAL_MINUTES=60
ERROR_MIN_NOTIFICATION_SEVERITY=error
ERROR_MONITORING_ENVIRONMENTS=
ERROR_SHOW_STACK_TRACES=true
ERROR_QUEUE_NOTIFICATIONS=false
ERROR_PREVENT_RECURSION=true
